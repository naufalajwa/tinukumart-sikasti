      const modalTutupBooth = document.getElementById('modalTutupBooth');

      // Helper Format Rupiah
      const formatRp = (num) => 'Rp ' + Number(num || 0).toLocaleString('id-ID');

      // Toast Notification
      const showToast = (message, icon = 'info') => {
        if (!toast || !toastMsg) return;
        toastMsg.textContent = message;
        const iconEl = document.getElementById('toastIcon');
        if (iconEl) iconEl.textContent = icon;
        toast.classList.remove('opacity-0', 'pointer-events-none');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.add('opacity-0', 'pointer-events-none');
          toast.classList.remove('opacity-100');
        }, 2500);
      };

      // Modal Open/Close Helpers
      const openModal = (el) => el && el.classList.remove('hidden');
      const closeModal = (el) => el && el.classList.add('hidden');

      document.querySelectorAll('.close-modal-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          closeModal(document.getElementById(targetId));
        });
      });

      [modalEstafet, modalInputTitipan, modalPembayaranTunai, modalPembayaranQris, modalReturTitipan, modalTutupBooth].forEach(m => {
        if (m) {
          m.addEventListener('click', (e) => {
            if (e.target === m) closeModal(m);
          });
        }
      });

      // Live Clock
      const updateClock = () => {
        const now = new Date();
        const hrs = String(now.getHours()).padStart(2, '0');
        const mins = String(now.getMinutes()).padStart(2, '0');
        const secs = String(now.getSeconds()).padStart(2, '0');
        const el = document.getElementById('liveClockDisplay');
        if (el) el.textContent = `${hrs}:${mins}:${secs} WIB`;
      };
      setInterval(updateClock, 1000);
      updateClock();

      // Hitung Total Keranjang (Murni harga barang tanpa potongan)
      const getCartTotals = () => {
        const subtotal = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);
        const grandTotal = subtotal;
        return { subtotal, grandTotal };
      };

      // Render Cart
      const renderCart = () => {
        if (!cartContainer) return;
        cartContainer.innerHTML = '';
        let totalQty = 0;
        const { subtotal, grandTotal } = getCartTotals();

        if (cart.length === 0) {
          cartContainer.innerHTML = `
            <div class="py-10 flex flex-col items-center justify-center text-center text-outline">
              <span class="material-symbols-outlined text-[44px] mb-1 opacity-40">remove_shopping_cart</span>
              <p class="font-body-md text-[13px] font-bold text-on-surface">Keranjang Masih Kosong</p>
              <p class="font-body-sm text-[11px] text-on-surface-variant">Klik item katalog di sebelah kiri untuk menambah pesanan.</p>
            </div>
          `;
        } else {
          cart.forEach(item => {
            totalQty += item.qty;
            const lineTotal = item.price * item.qty;

            const row = document.createElement('div');
            row.className = 'pt-2.5 pb-2.5 flex items-center justify-between gap-2';
            row.dataset.id = String(item.id);
            row.innerHTML = `
              <div class="flex-1 min-w-0 pr-1">
                <h4 class="font-body-lg text-[13px] font-bold text-primary truncate leading-tight">${item.name}</h4>
                <span class="font-label-numeric text-[11px] text-on-surface-variant">@ ${formatRp(item.price)}</span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <div class="flex items-center bg-surface-container-low border border-surface-container rounded-lg p-0.5">
                  <button type="button" class="qty-btn-minus w-7 h-7 rounded bg-surface-container-lowest hover:bg-surface-container text-on-surface font-bold text-xs flex items-center justify-center transition-colors">-</button>
                  <span class="qty-val font-label-numeric text-[12px] font-bold px-2 text-center text-on-surface">${item.qty}</span>
                  <button type="button" class="qty-btn-plus w-7 h-7 rounded bg-surface-container-lowest hover:bg-surface-container text-on-surface font-bold text-xs flex items-center justify-center transition-colors">+</button>
                </div>
                <span class="font-label-numeric text-[12px] text-primary font-bold min-w-[70px] text-right">${formatRp(lineTotal)}</span>
                <button type="button" class="delete-item-btn w-7 h-7 text-outline hover:text-error hover:bg-error-container/40 rounded flex items-center justify-center transition-colors">
                  <span class="material-symbols-outlined text-[16px]">delete</span>
                </button>
              </div>
            `;
            cartContainer.appendChild(row);
          });
        }

        if (cartCountBadge) cartCountBadge.textContent = String(totalQty);
        if (subtotalDisplay) subtotalDisplay.textContent = formatRp(subtotal);
        if (grandTotalDisplay) grandTotalDisplay.textContent = formatRp(grandTotal);
      };

      // Event Listener: Tambah ke Keranjang
      document.querySelectorAll('.product-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const id = Number(card.dataset.id);
          const name = card.dataset.name || 'Produk';
          const price = Number(card.dataset.price || 0);
          const modal = Number(card.dataset.modal || 0);
          const tipe = card.dataset.tipe || 'tinuku';

          const existing = cart.find(i => i.id === id);
          if (existing) {
            existing.qty += 1;
          } else {
            cart.push({ id, name, price, modal, tipe, qty: 1 });
          }
          renderCart();
          showToast(`+1 ${name} ditambahkan`, 'check_circle');
        });
      });

      // Event Listener: +/- & Hapus dari Keranjang
      cartContainer?.addEventListener('click', (e) => {
        const target = e.target;
        const row = target.closest('[data-id]');
        if (!row) return;
        const id = Number(row.dataset.id);
        const item = cart.find(i => i.id === id);
        if (!item) return;

        if (target.closest('.qty-btn-minus')) {
          if (item.qty > 1) {
            item.qty -= 1;
          } else {
            cart = cart.filter(i => i.id !== id);
          }
          renderCart();
        } else if (target.closest('.qty-btn-plus')) {
          item.qty += 1;
          renderCart();
        } else if (target.closest('.delete-item-btn')) {
          cart = cart.filter(i => i.id !== id);
          renderCart();
          showToast(`${item.name} dihapus dari pesanan`, 'delete');
        }
      });

      // Kosongkan Keranjang
      document.getElementById('clearCartBtn')?.addEventListener('click', () => {
        if (cart.length > 0) {
          cart = [];
          renderCart();
          showToast('Keranjang pesanan dikosongkan', 'delete_sweep');
        }
      });

      // Category Filter Pills
      document.querySelectorAll('.cat-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.cat-pill').forEach(p => {
            p.className = 'cat-pill px-4 py-2 rounded-lg font-label-action text-[13px] font-semibold flex items-center gap-1.5 bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-all';
          });
          pill.className = 'cat-pill px-4 py-2 rounded-lg font-label-action text-[13px] font-bold flex items-center gap-1.5 bg-primary text-on-primary shadow-xs transition-all';

          const cat = pill.dataset.cat;
          document.querySelectorAll('.product-card').forEach(card => {
            if (cat === 'all' || card.dataset.cat === cat) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });

      // Search Bar Filter
      const searchInput = document.getElementById('productSearchInput');
      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        document.querySelectorAll('.product-card').forEach(card => {
          const name = (card.dataset.name || '').toLowerCase();
          if (name.includes(query)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });

      // Quick Cash Calculations
      const updateCashModal = () => {
        const { grandTotal } = getCartTotals();
        const billAmountEl = document.getElementById('cashModalBillAmount');
        if (billAmountEl) billAmountEl.textContent = formatRp(grandTotal);

        const container = document.getElementById('quickCashButtonsContainer');
        if (container) {
          const pas = grandTotal;
          const roundedUp = Math.ceil(grandTotal / 10000) * 10000;
          const bigCash = roundedUp < 50000 ? 50000 : 100000;

          const options = Array.from(new Set([pas, roundedUp, bigCash])).slice(0, 3);
          container.innerHTML = options.map(amt => `
            <button type="button" class="quick-cash-chip py-2 px-1 rounded-lg bg-surface-container hover:bg-secondary-container hover:text-on-secondary-container font-label-numeric text-[13px] font-bold text-on-surface transition-all" data-cash="${amt}">
              ${amt === pas ? `${formatRp(amt)} (Pas)` : formatRp(amt)}
            </button>
          `).join('');

          container.querySelectorAll('.quick-cash-chip').forEach(btn => {
            btn.addEventListener('click', () => {
              const cashInput = document.getElementById('inputUangPembeli');
              if (cashInput) {
                cashInput.value = btn.dataset.cash;
                calcChange();
              }
            });
          });
        }

        const input = document.getElementById('inputUangPembeli');
        if (input) {
          input.value = String(grandTotal);
          calcChange();
        }
      };

      const calcChange = () => {
        const { grandTotal } = getCartTotals();
        const input = document.getElementById('inputUangPembeli');
        const changeDisplay = document.getElementById('cashChangeDisplay');
        const badge = document.getElementById('cashChangeBadgeStatus');

        const given = Number(input?.value || 0);
        const change = given - grandTotal;

        if (changeDisplay) changeDisplay.textContent = formatRp(Math.max(0, change));
        if (badge) {
          if (change < 0) {
            badge.textContent = 'Uang Kurang ' + formatRp(Math.abs(change));
            badge.className = 'font-label-badge text-[10px] text-error bg-error-container px-2 py-0.5 rounded font-bold uppercase';
          } else {
            badge.textContent = change === 0 ? 'Uang Pas' : 'Kembalian Cukup';
            badge.className = 'font-label-badge text-[10px] text-primary bg-primary-fixed px-2 py-0.5 rounded font-bold uppercase';
          }
        }
      };

      document.getElementById('inputUangPembeli')?.addEventListener('input', calcChange);

      // Trigger Tunai Modal [F9]
      const triggerCash = () => {
        const { grandTotal } = getCartTotals();
        if (grandTotal <= 0) {
          showToast('Keranjang masih kosong!', 'error');
          return;
        }
        updateCashModal();
        openModal(modalPembayaranTunai);
      };
      document.getElementById('triggerPayCashBtn')?.addEventListener('click', triggerCash);

      // Trigger QRIS Modal [F10]
      const triggerQris = () => {
        const { grandTotal } = getCartTotals();
        if (grandTotal <= 0) {
          showToast('Keranjang masih kosong!', 'error');
          return;
        }
        const billEl = document.getElementById('qrisModalBillAmount');
        if (billEl) billEl.textContent = formatRp(grandTotal);
        openModal(modalPembayaranQris);
      };
      document.getElementById('triggerPayQrisBtn')?.addEventListener('click', triggerQris);

      // PROSES CHECKOUT TRANSAKSI (SIMPAN KE DB)
      const submitCheckout = async (metode, cashDiterima = 0) => {
        const { grandTotal } = getCartTotals();
        const payload = {
          shift_id: activeShiftId,
          metode,
          total: grandTotal,
          cash_diterima: metode === 'TUNAI' ? cashDiterima : null,
          kembalian: metode === 'TUNAI' ? Math.max(0, cashDiterima - grandTotal) : null,
          items: cart.map(i => ({
            item_ref_id: i.id,
            tipe_item: i.tipe,
            nama_snapshot: i.name,
            harga_satuan_snapshot: i.price,
            harga_modal_snapshot: i.modal || 0,
            qty: i.qty,
            subtotal: i.price * i.qty,
          }))
        };

        try {
          const res = await fetch('/api/transaksi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeModal(modalPembayaranTunai);
            closeModal(modalPembayaranQris);
            showToast(`Transaksi #${data.transactionId} Sukses (${metode})! Struk tercetak.`, 'check_circle');
            cart = [];
            renderCart();
            // Refresh order number
            const codeEl = document.getElementById('orderCodeDisplay');
            if (codeEl) codeEl.textContent = `#TM-${Math.floor(1000 + Math.random() * 9000)}`;
          } else {
            showToast(data.error || 'Gagal menyimpan transaksi', 'error');
          }
        } catch (e) {
          showToast('Koneksi terputus ke server', 'error');
        }
      };

      document.getElementById('btnCompleteCashTransaction')?.addEventListener('click', () => {
        const input = document.getElementById('inputUangPembeli');
        const given = Number(input?.value || 0);
        const { grandTotal } = getCartTotals();
        if (given < grandTotal) {
          showToast('Uang pembeli masih kurang!', 'error');
          return;
        }
        submitCheckout('TUNAI', given);
      });

      document.getElementById('btnCompleteQrisTransaction')?.addEventListener('click', () => {
        submitCheckout('QRIS');
      });

      // Modals Trigger
      document.getElementById('triggerEstafetShiftBtn')?.addEventListener('click', () => openModal(modalEstafet));
      document.getElementById('triggerInputTitipanBtn')?.addEventListener('click', () => openModal(modalInputTitipan));
      document.getElementById('triggerReturTitipanBtn')?.addEventListener('click', () => openModal(modalReturTitipan));
      document.getElementById('triggerTutupBoothBtn')?.addEventListener('click', () => openModal(modalTutupBooth));

      // Form Input Titipan (UC03)
      document.getElementById('formInputTitipan')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          action: 'input',
          nama_produk: document.getElementById('titipanNamaProduk').value,
          qty_masuk: document.getElementById('titipanQty').value,
          harga_awal: document.getElementById('titipanHargaPokok').value,
          penitip: document.getElementById('titipanPenitip').value,
        };

        try {
          const res = await fetch('/api/konsinyasi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeModal(modalInputTitipan);
            showToast('Barang titipan berhasil dicatat!', 'check_circle');
            setTimeout(() => location.reload(), 800);
          } else {
            showToast(data.error || 'Gagal mencatat titipan', 'error');
          }
        } catch (err) {
          showToast('Error koneksi database', 'error');
        }
      });

      // Estafet Shift Handover (UC05)
      document.getElementById('btnSubmitShiftHandover')?.addEventListener('click', async () => {
        const kasAktual = Number(document.getElementById('physicalCashInput')?.value || 0);
        const nextCrewRadio = document.querySelector('input[name="shiftNextCrew"]:checked');
        const nextCrewId = nextCrewRadio ? nextCrewRadio.value : null;

        try {
          const res = await fetch('/api/shift', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'handover',
              shift_id: activeShiftId,
              kas_aktual: kasAktual,
              next_crew_id: nextCrewId,
            }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeModal(modalEstafet);
            showToast('Estafet shift berhasil disimpan!', 'check_circle');
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast(data.error || 'Gagal menyimpan estafet', 'error');
          }
        } catch (e) {
          showToast('Error saat mencatat estafet', 'error');
        }
      });

      // Retur Titipan (UC06)
      document.querySelectorAll('.btn-process-retur').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          const input = document.querySelector(`.retur-sisa-input[data-id="${id}"]`);
          const sisaAktual = Number(input?.value || 0);

          try {
            const res = await fetch('/api/konsinyasi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'retur',
                id,
                qty_sisa_aktual: sisaAktual,
              }),
            });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast(data.message, 'check_circle');
              setTimeout(() => location.reload(), 1000);
            } else {
              showToast(data.error || 'Gagal memproses retur', 'error');
            }
          } catch (e) {
            showToast('Error koneksi retur', 'error');
          }
        });
      });

      // Tutup Shift (UC07)
      document.getElementById('btnConfirmTutupShift')?.addEventListener('click', async () => {
        const kasAktual = Number(document.getElementById('closingPhysicalCashInput')?.value || 0);

        try {
          const res = await fetch('/api/shift', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'close',
              shift_id: activeShiftId,
              kas_aktual: kasAktual,
            }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeModal(modalTutupBooth);
            showToast('Shift berhasil ditutup!', 'check_circle');
            setTimeout(() => {
              window.location.href = '/kasir/dashboard';
            }, 1000);
          } else {
            showToast(data.error || 'Gagal menutup shift', 'error');
          }
        } catch (e) {
          showToast('Error saat menutup shift', 'error');
        }
      });

      // Keyboard Hotkeys [F2, F4, F9, F10, ESC]
      window.addEventListener('keydown', (e) => {
        if (e.key === 'F2') {
          e.preventDefault();
          searchInput?.focus();
        } else if (e.key === 'F4') {
          e.preventDefault();
          openModal(modalInputTitipan);
        } else if (e.key === 'F9') {
          e.preventDefault();
          triggerCash();
        } else if (e.key === 'F10') {
          e.preventDefault();
          triggerQris();
        } else if (e.key === 'Escape') {
          [modalEstafet, modalInputTitipan, modalPembayaranTunai, modalPembayaranQris, modalReturTitipan, modalTutupBooth].forEach(closeModal);
        }
      });

      // Inisialisasi Keranjang Awal
      renderCart();
    })();
  </script>
</Layout>
