---
import Layout from '@/layouts/Layout.astro';
import { createDb } from '@db/index';
import { shifts, shiftPenjaga, users, produk, konsinyasi } from '@db/schema';
import { eq, and, sql } from 'drizzle-orm';

// 1. Verifikasi Session Kasir
const userRole = Astro.cookies.get('user_role')?.value;
const userNama = Astro.cookies.get('user_nama')?.value || 'Kasir';
const userId = Astro.cookies.get('user_id')?.value;

if (!userRole || userRole !== 'kasir' || !userId) {
  return Astro.redirect('/');
}

// 2. Format Tanggal Hari Ini
function getTodayDateStr(): string {
  const formatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Jakarta',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  return formatter.format(new Date());
}

function formatTanggalIndonesia(dateStr: string): string {
  const [year, month, day] = dateStr.split('-');
  const bulan = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];
  return `${parseInt(day, 10)} ${bulan[parseInt(month, 10) - 1]} ${year}`;
}

const todayDate = getTodayDateStr();
const todayDisplay = formatTanggalIndonesia(todayDate);

// 3. Database Query
const dbBinding = Astro.locals?.runtime?.env?.DB;
let activeShift: typeof shifts.$inferSelect | null = null;
let allProducts: Array<{
  id: number;
  nama: string;
  tipe: 'tinuku' | 'konsinyasi';
  harga_jual: number;
  harga_modal: number;
  is_active: boolean;
  stok?: number;
  penitip?: string;
}> = [];

let cashierUsers: Array<{ id: number; nama: string }> = [];
let consignmentItems: Array<typeof konsinyasi.$inferSelect> = [];

if (dbBinding) {
  const db = createDb(dbBinding);

  // Ambil Shift Aktif Hari Ini
  const [openShift] = await db
    .select()
    .from(shifts)
    .where(and(eq(shifts.status, 'OPEN'), eq(shifts.tanggal, todayDate)))
    .limit(1);

  if (openShift) {
    activeShift = openShift;
  }

  // Ambil Produk Tinuku yang Aktif
  const dbProduk = await db
    .select()
    .from(produk)
    .where(eq(produk.is_active, true));

  // Ambil Konsinyasi Aktif Hari Ini
  const dbKonsinyasi = await db
    .select()
    .from(konsinyasi)
    .where(eq(konsinyasi.status, 'OPEN'));

  consignmentItems = dbKonsinyasi;

  // Gabungkan produk untuk katalog POS
  allProducts = [
    ...dbProduk.map((p) => ({
      id: p.id,
      nama: p.nama,
      tipe: 'tinuku' as const,
      harga_jual: p.harga_jual,
      harga_modal: p.harga_modal,
      is_active: p.is_active,
      stok: 25, // default catalog stock
    })),
    ...dbKonsinyasi.map((k) => ({
      id: k.id,
      nama: `${k.nama_produk} (Titipan)`,
      tipe: 'konsinyasi' as const,
      harga_jual: Math.round(k.harga_awal * 1.2), // harga jual dengan margin default
      harga_modal: k.harga_awal,
      is_active: true,
      stok: k.qty_sisa,
      penitip: k.penitip,
    })),
  ];

  // Daftar kasir untuk ganti shift estafet
  cashierUsers = await db
    .select({ id: users.id, nama: users.nama })
    .from(users)
    .where(eq(users.role, 'kasir'));
}

// Fallback jika belum ada produk di database
if (allProducts.length === 0) {
  allProducts = [
    { id: 1, nama: 'Nasi Ayam Geprek Sambal Korek', tipe: 'tinuku', harga_jual: 15000, harga_modal: 10000, is_active: true, stok: 14 },
    { id: 2, nama: 'Es Teh Kampus Jumbo', tipe: 'tinuku', harga_jual: 5000, harga_modal: 2000, is_active: true, stok: 48 },
    { id: 3, nama: 'Risol Mayo Beef Melt (Titipan)', tipe: 'konsinyasi', harga_jual: 8000, harga_modal: 6500, is_active: true, stok: 6, penitip: 'Kak Sarah' },
    { id: 4, nama: 'Kopi Susu Gula Aren', tipe: 'tinuku', harga_jual: 12000, harga_modal: 7000, is_active: true, stok: 22 },
    { id: 5, nama: 'Mie Dok-Dok Special Telur', tipe: 'tinuku', harga_jual: 13000, harga_modal: 8000, is_active: true, stok: 11 },
    { id: 6, nama: 'Keripik Kaca Pedas (Titipan)', tipe: 'konsinyasi', harga_jual: 6000, harga_modal: 4500, is_active: true, stok: 19, penitip: 'BEM FEB' },
  ];
}

// Order ID generator
const randomOrderNum = Math.floor(1000 + Math.random() * 9000);
const orderCode = `TM-${randomOrderNum}`;
---

<Layout title="Point of Sale (POS) - Kasir Booth">
  <div class="min-h-screen bg-surface font-body-md text-on-surface antialiased flex flex-col">

    <!-- TOP HEADER -->
    <header class="fixed top-0 left-0 right-0 z-40 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.06)] border-b border-surface-container">
      <div class="h-16 w-full px-margin-desktop flex items-center justify-between gap-space-md">
        <!-- Brand & Booth Location -->
        <div class="flex items-center gap-space-md shrink-0">
          <a href="/kasir/dashboard" class="flex items-center gap-space-xs hover:opacity-90 transition-opacity">
            <span class="material-symbols-outlined text-primary text-[28px]">storefront</span>
            <span class="font-headline-sm text-lg font-bold text-primary">TinukuMart</span>
          </a>
          <div class="h-6 w-[1.5px] bg-outline-variant/60 hidden sm:block"></div>
          <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 bg-surface-container-low rounded-lg border border-surface-container">
            <span class="material-symbols-outlined text-primary text-[18px]">location_on</span>
            <span class="font-label-action text-[13px] text-on-surface font-semibold">Kantin Pusat - Booth #04</span>
          </div>
        </div>

        <!-- Real-time Clock, Cashier Status & Action Buttons -->
        <div class="flex items-center gap-space-md">
          <!-- Live Clock -->
          <div class="hidden md:flex flex-col text-right pr-2">
            <span class="font-label-numeric text-[13px] font-bold text-primary tracking-tight" id="liveClockDisplay">--:--:-- WIB</span>
            <span class="font-body-sm text-[11px] text-on-surface-variant">{todayDisplay}</span>
          </div>
          <div class="h-6 w-[1px] bg-outline-variant/50 hidden md:block"></div>

          <!-- Active Cashier Profile -->
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-xs shadow-xs">
              {userNama.substring(0, 2).toUpperCase()}
            </div>
            <div class="hidden sm:flex flex-col text-left">
              <span class="font-label-action text-[13px] font-bold text-primary leading-tight">{userNama}</span>
              <span class="font-body-sm text-[11px] text-on-surface-variant font-medium">
                {activeShift ? `Shift ${activeShift.shift_ke}` : 'Belum Buka Shift'}
              </span>
            </div>
          </div>

          <!-- Shift & Booth Action Buttons -->
          <div class="flex items-center gap-2">
            <!-- Ganti Penjaga Shift Trigger (UC05) -->
            <button
              type="button"
              class="h-9 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container-high border border-outline-variant text-primary flex items-center gap-1.5 font-label-action text-[12px] font-bold transition-all shadow-xs active:scale-95"
              id="triggerEstafetShiftBtn"
              title="Ganti Penjaga Shift (Estafet Kasir)"
            >
              <span class="material-symbols-outlined text-[18px]">sync_alt</span>
              <span class="hidden sm:inline">Ganti Penjaga Shift</span>
              <span class="sm:hidden">Shift</span>
            </button>

            <!-- Tutup Booth Trigger (UC07) -->
            <button
              type="button"
              class="h-9 px-3 rounded-lg bg-error-container/40 hover:bg-error-container border border-error/30 text-error flex items-center gap-1.5 font-label-action text-[12px] font-bold transition-all active:scale-95 shadow-xs"
              id="triggerTutupBoothBtn"
              title="Tutup Booth & Selesaikan Shift"
            >
              <span class="material-symbols-outlined text-[18px]">meeting_room</span>
              <span class="hidden sm:inline">Tutup Booth</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- QUICK ACTION KONSINYASI (TITIPAN) BAR -->
    <section class="mt-16 w-full bg-gradient-to-r from-surface-container-low via-surface-container to-surface-container-low border-b border-surface-container px-margin-desktop py-2.5">
      <div class="w-full flex flex-wrap items-center justify-between gap-space-sm">
        <div class="flex items-center gap-2">
          <span class="flex items-center justify-center w-6 h-6 rounded-full bg-secondary-container text-on-secondary-container">
            <span class="material-symbols-outlined text-[16px]">local_convenience_store</span>
          </span>
          <span class="font-label-action text-[13px] font-bold text-primary">Modul Konsinyasi Mahasiswa:</span>
          <span class="font-body-sm text-[12px] text-on-surface-variant hidden md:inline">Kelola titipan barang masuk & retur harian booth</span>
        </div>
        <div class="flex items-center gap-space-sm">
          <!-- Input Titipan Pagi Button (UC03) -->
          <button
            type="button"
            class="h-8 px-3 rounded-lg bg-surface-container-lowest hover:bg-primary hover:text-on-primary border border-primary text-primary flex items-center gap-1.5 font-label-action text-[12px] font-bold transition-all shadow-xs active:scale-95 group"
            id="triggerInputTitipanBtn"
          >
            <span class="material-symbols-outlined text-[16px] text-primary group-hover:text-on-primary">file_download</span>
            <span>📥 Input Titipan Pagi [F4]</span>
          </button>
          <!-- Retur Sisa Titipan Button (UC06) -->
          <button
            type="button"
            class="h-8 px-3 rounded-lg bg-surface-container-lowest hover:bg-secondary-gold hover:text-white border border-secondary-gold text-secondary-gold flex items-center gap-1.5 font-label-action text-[12px] font-bold transition-all shadow-xs active:scale-95 group"
            id="triggerReturTitipanBtn"
          >
            <span class="material-symbols-outlined text-[16px] text-secondary-gold group-hover:text-white">file_upload</span>
            <span>📤 Retur Sisa Titipan</span>
          </button>
        </div>
      </div>
    </section>

    <!-- NOTIFIKASI JIKA SHIFT BELUM DIBUKA -->
    {!activeShift && (
      <div class="w-full bg-secondary-container text-on-secondary-container px-margin-desktop py-3 flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[22px]">warning</span>
          <span class="font-bold text-sm">Shift kasir hari ini belum dibuka. Silakan buka shift terlebih dahulu untuk merekam kas modal awal.</span>
        </div>
        <a
          href="/kasir/dashboard"
          class="px-4 py-1.5 rounded-lg bg-primary text-on-primary font-bold text-xs shadow-xs hover:bg-primary-dark transition"
        >
          Buka Shift Sekarang &rarr;
        </a>
      </div>
    )}

    <!-- MAIN POS DUAL-PANE CONSOLE -->
    <main class="w-full px-margin-desktop py-space-md flex-1 pb-16">
      <div class="flex flex-col lg:flex-row gap-space-lg items-start w-full">
        
        <!-- 60% LEFT COLUMN: PRODUCT CATALOG -->
        <section class="w-full lg:w-[60%] flex flex-col gap-space-md min-w-0">
          
          <!-- Search & Filter Controls -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-space-sm bg-surface-container-lowest p-space-sm rounded-xl border border-surface-container shadow-xs">
            <!-- Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="categoryNav">
              <button
                type="button"
                class="cat-pill px-4 py-2 rounded-lg font-label-action text-[13px] font-bold flex items-center gap-1.5 bg-primary text-on-primary shadow-xs transition-all"
                data-cat="all"
              >
                <span>Semua</span>
                <span class="px-1.5 py-0.2 rounded-full bg-white/20 text-[11px] font-label-numeric">{allProducts.length}</span>
              </button>
              <button
                type="button"
                class="cat-pill px-4 py-2 rounded-lg font-label-action text-[13px] font-semibold flex items-center gap-1.5 bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-all"
                data-cat="tinuku"
              >
                <span>Menu Tinuku</span>
                <span class="px-1.5 py-0.2 rounded-full bg-primary-fixed text-primary font-bold text-[11px] font-label-numeric">
                  {allProducts.filter(p => p.tipe === 'tinuku').length}
                </span>
              </button>
              <button
                type="button"
                class="cat-pill px-4 py-2 rounded-lg font-label-action text-[13px] font-semibold flex items-center gap-1.5 bg-surface-container-low hover:bg-surface-container text-on-surface-variant transition-all"
                data-cat="konsinyasi"
              >
                <span>Barang Titipan</span>
                <span class="px-1.5 py-0.2 rounded-full bg-secondary-container text-on-secondary-container font-bold text-[11px] font-label-numeric">
                  {allProducts.filter(p => p.tipe === 'konsinyasi').length}
                </span>
              </button>
            </div>

            <!-- Quick Search Input -->
            <div class="relative flex-1 sm:max-w-[240px]">
              <span class="material-symbols-outlined absolute left-2.5 top-2 text-outline text-[18px] pointer-events-none">search</span>
              <input
                class="w-full h-9 pl-8 pr-3 bg-surface-container-low border border-surface-container rounded-lg text-on-surface text-[13px] placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:border-primary transition-all"
                id="productSearchInput"
                placeholder="Cari menu / scan [F2]..."
                type="text"
              />
            </div>
          </div>

          <!-- Product Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3.5" id="productGrid">
            {allProducts.map((p) => (
              <div
                class="product-card group bg-surface-container-lowest rounded-xl p-3 border border-surface-container hover:border-primary/40 shadow-xs hover:shadow-md transition-all cursor-pointer flex flex-col justify-between"
                data-cat={p.tipe}
                data-id={p.id}
                data-tipe={p.tipe}
                data-name={p.nama}
                data-price={p.harga_jual}
                data-modal={p.harga_modal}
              >
                <div>
                  <div class="flex items-center justify-between gap-1 mb-2">
                    <span class={`px-2 py-0.5 rounded-md font-label-badge text-[11px] font-bold ${
                      p.tipe === 'tinuku'
                        ? 'bg-primary-fixed text-primary'
                        : 'bg-secondary-container text-on-secondary-container'
                    }`}>
                      {p.tipe === 'tinuku' ? 'Menu Booth' : (p.penitip ? `Titipan ${p.penitip}` : 'Titipan Mahasiswa')}
                    </span>
                    <span class={`font-label-numeric text-[11px] ${p.stok && p.stok <= 6 ? 'text-error font-bold' : 'text-on-surface-variant'}`}>
                      Stok {p.stok || 10}
                    </span>
                  </div>

                  <!-- Product Icon Thumbnail -->
                  <div class="h-28 w-full rounded-lg bg-surface-container-low mb-2.5 overflow-hidden relative flex items-center justify-center">
                    <span class="material-symbols-outlined text-[48px] text-primary/40 group-hover:scale-110 transition-transform">
                      {p.tipe === 'tinuku' ? 'lunch_dining' : 'bakery_dining'}
                    </span>
                    {p.tipe === 'konsinyasi' && (
                      <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 bg-secondary-gold text-white font-label-badge text-[10px] rounded font-bold">
                        KONSINYASI
                      </span>
                    )}
                  </div>

                  <h3 class="font-headline-sm text-[15px] font-bold text-primary line-clamp-1">{p.nama}</h3>
                  <p class="font-body-sm text-[12px] text-on-surface-variant line-clamp-1">
                    {p.tipe === 'tinuku' ? 'Menu asli booth TinukuMart' : `Titipan: ${p.penitip || 'Mahasiswa'}`}
                  </p>
                </div>

                <div class="flex items-center justify-between mt-3 pt-2 border-t border-surface-container">
                  <div>
                    <span class="font-body-sm text-[10px] text-outline block leading-none">Harga</span>
                    <span class="font-headline-sm text-[16px] font-extrabold text-primary">
                      Rp {p.harga_jual.toLocaleString('id-ID')}
                    </span>
                  </div>
                  <button
                    type="button"
                    class="add-to-cart-btn h-8 px-2.5 rounded-lg bg-primary hover:bg-primary-dark text-on-primary flex items-center gap-1 font-label-action text-[12px] font-bold shadow-xs active:scale-95 transition-all"
                  >
                    <span class="material-symbols-outlined text-[16px]">add</span> Tambah
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 40% RIGHT COLUMN: CART & ORDER SUMMARY -->
        <aside class="w-full lg:w-[40%] sticky top-20 flex flex-col bg-surface-container-lowest rounded-2xl shadow-md border border-surface-container overflow-hidden">
          
          <!-- Cart Header -->
          <div class="p-space-md bg-surface-container-low border-b border-surface-container flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">shopping_bag</span>
                <h2 class="font-headline-sm text-[17px] font-bold text-primary">
                  Pesanan Aktif <span class="font-label-numeric text-[13px] text-on-surface-variant" id="orderCodeDisplay">#{orderCode}</span>
                </h2>
              </div>
              <button
                type="button"
                class="px-2 py-1 rounded text-outline hover:text-error hover:bg-error-container/40 transition-colors font-label-action text-[12px] flex items-center gap-1 font-semibold"
                id="clearCartBtn"
                title="Kosongkan Pesanan"
              >
                <span class="material-symbols-outlined text-[16px]">delete_sweep</span>
                <span>Kosongkan</span>
              </button>
            </div>
          </div>

          <!-- Selected Items Container (Scrollable) -->
          <div class="p-space-md flex flex-col gap-2 max-h-[300px] overflow-y-auto divide-y divide-surface-container" id="cartItemsContainer">
            <!-- Populated via JavaScript -->
          </div>

          <!-- Order Subtotal Details -->
          <div class="p-space-md bg-surface-container-low/70 border-t border-surface-container flex flex-col gap-1.5">
            <div class="flex justify-between items-center text-[13px] text-on-surface-variant">
              <span>Total Item (<span class="font-bold" id="cartCountBadge">0</span> item)</span>
              <span class="font-label-numeric font-semibold text-on-surface" id="subtotalDisplay">Rp 0</span>
            </div>
          </div>

          <!-- Prominent Total Display Banner -->
          <div class="px-space-md py-3.5 bg-primary text-on-primary flex items-center justify-between">
            <div>
              <span class="font-label-action text-[11px] uppercase tracking-wider text-primary-fixed block font-bold">TOTAL PEMBAYARAN</span>
              <span class="font-body-sm text-[11px] text-on-primary-container">Total pesanan kasir booth</span>
            </div>
            <div class="text-right">
              <span class="font-currency-display text-[26px] font-extrabold text-secondary-container tracking-tight" id="grandTotalDisplay">
                Rp 0
              </span>
            </div>
          </div>

          <!-- Checkout Action Buttons -->
          <div class="p-space-md flex flex-col gap-2.5 bg-surface-container-lowest border-t border-surface-container">
            <!-- TUNAI Button -->
            <button
              type="button"
              class="w-full h-13 py-3 rounded-xl bg-secondary-container hover:bg-yellow-400 text-on-secondary-container flex items-center justify-between px-4 shadow-sm hover:shadow-md transition-all active:scale-[0.99] font-extrabold group"
              id="triggerPayCashBtn"
            >
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[24px]">payments</span>
                <span class="font-headline-sm text-[16px] tracking-wide">💵 BAYAR TUNAI</span>
              </div>
              <span class="text-[12px] font-label-numeric px-2 py-0.5 rounded bg-black/10 text-on-secondary-container">[F9]</span>
            </button>

            <!-- QRIS Button -->
            <button
              type="button"
              class="w-full h-13 py-3 rounded-xl bg-primary hover:bg-primary-dark text-on-primary flex items-center justify-between px-4 shadow-sm hover:shadow-md transition-all active:scale-[0.99] font-extrabold group"
              id="triggerPayQrisBtn"
            >
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[24px] text-secondary-container">qr_code_scanner</span>
                <span class="font-headline-sm text-[16px] tracking-wide">📱 BAYAR QRIS</span>
              </div>
              <span class="text-[12px] font-label-numeric px-2 py-0.5 rounded bg-white/20 text-on-primary">[F10]</span>
            </button>

            <!-- Secondary Bottom Actions -->
            <div class="grid grid-cols-3 gap-2 pt-1">
              <button
                type="button"
                class="py-1.5 px-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-label-action text-[12px] flex items-center justify-center gap-1 transition-colors"
                id="btnHoldOrder"
              >
                <span class="material-symbols-outlined text-[15px]">pause_circle</span> Hold
              </button>
              <button
                type="button"
                class="py-1.5 px-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-label-action text-[12px] flex items-center justify-center gap-1 transition-colors"
                id="btnPrintReceipt"
              >
                <span class="material-symbols-outlined text-[15px]">receipt</span> Struk
              </button>
              <button
                type="button"
                class="py-1.5 px-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-label-action text-[12px] flex items-center justify-center gap-1 transition-colors"
                id="btnSendWa"
              >
                <span class="material-symbols-outlined text-[15px]">send_to_mobile</span> WA
              </button>
            </div>
          </div>
        </aside>

      </div>
    </main>

    <!-- BOTTOM STATUS / HOTKEY FOOTER -->
    <footer class="fixed bottom-0 left-0 right-0 z-30 bg-surface-container-lowest border-t border-surface-container px-margin-desktop py-2">
      <div class="flex items-center justify-between gap-4 text-xs text-on-surface-variant">
        <div class="flex items-center gap-4 overflow-x-auto">
          <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-surface-container font-mono text-[10px] font-bold">F2</kbd> Cari Produk</span>
          <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-surface-container font-mono text-[10px] font-bold">F4</kbd> Input Titipan</span>
          <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-secondary-container text-on-secondary-container font-mono text-[10px] font-bold">F9</kbd> Tunai</span>
          <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-primary text-white font-mono text-[10px] font-bold">F10</kbd> QRIS</span>
          <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded bg-surface-container font-mono text-[10px] font-bold">ESC</kbd> Tutup / Batal</span>
