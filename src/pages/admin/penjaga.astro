---
import Layout from '@/layouts/Layout.astro';
import AdminSidebar from '@/components/AdminSidebar.astro';
import { createDb } from '@db/index';
import { users } from '@db/schema';
import { eq, desc } from 'drizzle-orm';

// 1. Verifikasi Session Admin
const userRole = Astro.cookies.get('user_role')?.value;
const userNama = Astro.cookies.get('user_nama')?.value || 'Admin';

if (!userRole || userRole !== 'admin') {
  return Astro.redirect('/');
}

// 2. Handle POST Request untuk Tambah / Kelola Penjaga
const dbBinding = Astro.locals?.runtime?.env?.DB;
let notificationMessage = '';
let notificationError = '';

if (Astro.request.method === 'POST' && dbBinding) {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');
    const db = createDb(dbBinding);

    if (action === 'create') {
      const nama = String(formData.get('nama') || '').trim();
      const pin = String(formData.get('pin') || '').trim();
      const no_hp = String(formData.get('no_hp') || '').trim() || null;
      const email = String(formData.get('email') || '').trim() || null;

      if (!nama || !pin || pin.length < 4) {
        notificationError = 'Nama penjaga dan PIN minimal 4 angka wajib diisi.';
      } else {
        await db.insert(users).values({
          nama,
          pin,
          role: 'kasir',
          no_hp,
          email,
        });
        notificationMessage = `Penjaga shift "${nama}" berhasil didaftarkan dengan PIN ${pin}.`;
      }
    } else if (action === 'delete') {
      const id = Number(formData.get('id'));
      await db.delete(users).where(eq(users.id, id));
      notificationMessage = 'Data penjaga berhasil dihapus.';
    }
  } catch (e: any) {
    notificationError = 'Gagal memproses data penjaga: ' + e?.message;
  }
}

// 3. Query Database
let attendantsList: Array<typeof users.$inferSelect> = [];

if (dbBinding) {
  const db = createDb(dbBinding);
  attendantsList = await db
    .select()
    .from(users)
    .where(eq(users.role, 'kasir'))
    .orderBy(desc(users.id));
}
---

<Layout title="Data Penjaga Shift & Kasir - UC09">
  <div class="min-h-screen bg-surface flex font-body-md text-on-surface">
    
    <!-- Sidebar Navigation -->
    <AdminSidebar activePath="penjaga" userNama={userNama} />

    <!-- Main Content Area -->
    <div class="flex-1 lg:pl-64 pl-0 flex flex-col min-w-0 transition-all duration-300">
      
      <!-- Top Sticky Bar -->
      <header class="h-16 bg-surface-container-lowest border-b border-surface-container px-4 sm:px-6 lg:px-8 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
          <!-- Mobile Hamburger Toggle -->
          <button
            type="button"
            class="btn-open-sidebar lg:hidden p-2 -ml-1 rounded-xl text-primary hover:bg-surface-container transition flex items-center justify-center shrink-0"
            title="Buka Menu Navigasi"
          >
            <span class="material-symbols-outlined text-[24px]">menu</span>
          </button>

          <span class="material-symbols-outlined text-primary text-[24px] hidden sm:block">group</span>
          <h2 class="font-headline-sm text-sm sm:text-base font-bold text-primary truncate">Data Penjaga Shift & Kasir</h2>
        </div>

        <button
          type="button"
          class="h-9 px-3 sm:px-4 rounded-xl bg-primary hover:bg-primary-dark text-on-primary font-bold text-xs flex items-center gap-1.5 shadow-xs transition active:scale-95 shrink-0"
          id="btnOpenTambahPenjaga"
        >
          <span class="material-symbols-outlined text-[18px]">person_add</span>
          <span class="hidden sm:inline">Daftarkan Penjaga Baru</span>
          <span class="sm:hidden">Tambah</span>
        </button>
      </header>

      <!-- Main Container -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl w-full">

        <!-- Flash Notifications -->
        {notificationMessage && (
          <div class="bg-primary-fixed/50 border border-primary/20 text-on-surface p-4 rounded-xl flex items-center gap-3 text-sm shadow-xs">
            <span class="material-symbols-outlined text-primary text-[20px]">check_circle</span>
            <span>{notificationMessage}</span>
          </div>
        )}
        {notificationError && (
          <div class="bg-error-container/40 border border-error/20 text-error p-4 rounded-xl flex items-center gap-3 text-sm shadow-xs">
            <span class="material-symbols-outlined text-error text-[20px]">error</span>
            <span>{notificationError}</span>
          </div>
        )}

        <!-- Header Title Banner -->
        <div>
          <div class="flex items-center gap-2 font-label-badge text-xs text-primary font-bold uppercase tracking-wider mb-1">
            <span>Personalia Booth</span>
            <span>&bull;</span>
            <span class="text-secondary-gold">Akun Akses Kasir (PIN)</span>
          </div>
          <h1 class="font-headline-lg text-2xl font-black text-primary tracking-tight">
            Data Penjaga Shift & Kasir Mahasiswa
          </h1>
          <p class="font-body-md text-xs sm:text-sm text-on-surface-variant mt-0.5">
            Daftar petugas mahasiswa yang memiliki otorisasi PIN untuk membuka laci kasir dan melayani transaksi di booth.
          </p>
        </div>

        <!-- Metric Counter Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex items-center justify-between">
            <div>
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider block">Total Petugas Kasir</span>
              <span class="font-currency-display text-2xl font-extrabold text-primary mt-1 block">{attendantsList.length} Petugas</span>
              <span class="font-body-sm text-[11px] text-on-surface-variant">Terdaftar aktif di sistem</span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-[24px]">badge</span>
            </div>
          </div>

          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex items-center justify-between">
            <div>
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider block">Metode Autentikasi</span>
              <span class="font-currency-display text-2xl font-extrabold text-on-surface mt-1 block">4-Digit PIN</span>
              <span class="font-body-sm text-[11px] text-on-surface-variant">Login cepat layar sentuh POS</span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-surface-container text-on-surface flex items-center justify-center">
              <span class="material-symbols-outlined text-[24px]">dialpad</span>
            </div>
          </div>

          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex items-center justify-between">
            <div>
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider block">Status Booth</span>
              <span class="font-currency-display text-2xl font-extrabold text-secondary-gold mt-1 block">Operasional</span>
              <span class="font-body-sm text-[11px] text-on-surface-variant">Booth #04 Kantin Pusat</span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold">
              <span class="material-symbols-outlined text-[24px]">storefront</span>
            </div>
          </div>
        </div>

        <!-- Data Table Container -->
        <div class="bg-surface-container-lowest rounded-2xl border border-surface-container shadow-xs overflow-hidden">
          <div class="p-5 border-b border-surface-container flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="font-headline-sm text-base font-bold text-primary">Daftar Akun Kasir Aktif</h3>
              <p class="font-body-sm text-xs text-on-surface-variant">Gunakan tombol hapus jika mahasiswa sudah purna tugas</p>
            </div>
            <div class="relative w-full sm:w-64">
              <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[18px]">search</span>
              <input
                type="text"
                id="searchPenjagaInput"
                placeholder="Cari nama kasir..."
                class="w-full h-9 pl-9 pr-3 bg-surface-container-low border border-outline-variant rounded-xl text-xs focus:outline-none focus:border-primary transition"
              />
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase font-bold tracking-wider border-b border-surface-container">
                  <th class="py-3.5 px-4 w-12 text-center">No</th>
                  <th class="py-3.5 px-4">Nama Petugas</th>
                  <th class="py-3.5 px-4">Kontak (HP / Email)</th>
                  <th class="py-3.5 px-4 text-center">Kode Akses PIN</th>
                  <th class="py-3.5 px-4 text-center">Status</th>
                  <th class="py-3.5 px-4 text-right">Aksi & Kirim PIN</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-surface-container" id="penjagaRowsContainer">
                {attendantsList.map((user, idx) => {
                  const waPhone = user.no_hp ? user.no_hp.replace(/[^0-9]/g, '').replace(/^0/, '62') : '';
                  const pinMsg = encodeURIComponent(`Halo ${user.nama},\n\nBerikut akses login Kasir SIKASTI TinukuMart Anda:\n• Username: ${user.nama}\n• PIN: ${user.pin}\n\nMohon jaga kerahasiaan PIN Anda. Terima kasih!`);
                  const waLink = waPhone ? `https://wa.me/${waPhone}?text=${pinMsg}` : '';
                  const mailLink = user.email ? `mailto:${user.email}?subject=${encodeURIComponent('Konfirmasi PIN Kasir SIKASTI TinukuMart')}&body=${pinMsg}` : '';

                  return (
                  <tr class="penjaga-row hover:bg-surface-container-low/50 transition" data-name={user.nama.toLowerCase()}>
                    <td class="py-3.5 px-4 text-center font-mono text-xs text-outline">{idx + 1}</td>
                    <td class="py-3.5 px-4 font-bold text-primary">
                      <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-bold text-xs shrink-0">
                          {user.nama.substring(0, 2).toUpperCase()}
                        </div>
                        <div>
                          <span class="block">{user.nama}</span>
                          <span class="text-[11px] font-mono text-outline font-normal">ID #{user.id}</span>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4 text-xs text-on-surface-variant">
                      {user.no_hp && (
                        <div class="flex items-center gap-1">
                          <span class="material-symbols-outlined text-[14px] text-green-700">call</span>
                          <span class="font-mono">{user.no_hp}</span>
                        </div>
                      )}
                      {user.email && (
                        <div class="flex items-center gap-1 mt-0.5">
                          <span class="material-symbols-outlined text-[14px] text-primary">mail</span>
                          <span class="truncate max-w-[160px]">{user.email}</span>
                        </div>
                      )}
                      {!user.no_hp && !user.email && <span class="text-outline italic">-</span>}
                    </td>
                    <td class="py-3.5 px-4 text-center font-mono font-bold text-primary tracking-widest">
                      {user.pin ? `•••• (${user.pin})` : '-'}
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      <span class="inline-flex items-center gap-1 text-green-700 font-bold text-xs">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span> Aktif
                      </span>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end gap-1.5">
                        {waLink && (
                          <a
                            href={waLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="px-2 py-1 rounded-lg bg-green-100 hover:bg-green-200 text-green-800 text-[11px] font-bold inline-flex items-center gap-1 transition"
                            title="Kirim Konfirmasi PIN via WhatsApp"
                          >
                            <span class="material-symbols-outlined text-[14px]">chat</span>
                            <span class="hidden sm:inline">Kirim WA</span>
                          </a>
                        )}
                        {mailLink && (
                          <a
                            href={mailLink}
                            class="px-2 py-1 rounded-lg bg-primary-fixed hover:bg-primary-fixed-dim text-primary text-[11px] font-bold inline-flex items-center gap-1 transition"
                            title="Kirim Konfirmasi PIN via Email"
                          >
                            <span class="material-symbols-outlined text-[14px]">forward_to_inbox</span>
                            <span class="hidden sm:inline">Email</span>
                          </a>
                        )}
                        <form method="POST" class="inline" onsubmit="return confirm('Hapus petugas ini dari sistem?')">
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="id" value={user.id} />
                          <button
                            type="submit"
                            class="p-1.5 rounded-lg bg-surface-container-low hover:bg-error-container hover:text-error text-on-surface-variant transition"
                            title="Hapus Petugas"
                          >
                            <span class="material-symbols-outlined text-[16px]">delete</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

      </main>

    </div>

    <!-- Modal Tambah Penjaga Baru -->
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden flex items-center justify-center p-4" id="modalTambahPenjaga">
      <div class="w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-2xl border border-surface-container overflow-hidden flex flex-col">
        <div class="px-5 py-4 bg-primary text-on-primary flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary-container text-[22px]">person_add</span>
            <h3 class="font-headline-sm text-base font-bold">Daftarkan Penjaga Kasir Baru</h3>
          </div>
          <button type="button" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white" id="btnCloseTambahPenjagaModal">
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>

        <form method="POST" class="p-5 flex flex-col gap-3.5">
          <input type="hidden" name="action" value="create" />

          <div class="flex flex-col gap-1">
            <label class="font-label-action text-xs font-bold text-on-surface">Nama Lengkap Mahasiswa:</label>
            <input class="h-10 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-sm" name="nama" placeholder="Contoh: Dimas Arya Pratama" required type="text" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="flex flex-col gap-1">
              <label class="font-label-action text-xs font-bold text-on-surface">Nomor HP / WhatsApp:</label>
              <input class="h-10 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-sm font-mono" name="no_hp" placeholder="081234567890" type="tel" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="font-label-action text-xs font-bold text-on-surface">Alamat Email:</label>
              <input class="h-10 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-sm" name="email" placeholder="nama@email.com" type="email" />
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <label class="font-label-action text-xs font-bold text-on-surface">Kode Akses PIN (4-6 Digit):</label>
            <input
              class="h-10 px-3 bg-surface-container-low border border-outline-variant rounded-lg font-mono text-base font-bold text-center tracking-widest"
              name="pin"
              type="password"
              maxlength="6"
              placeholder="••••"
              required
            />
            <span class="text-[11px] text-outline">PIN ini akan digunakan kasir untuk masuk ke sistem di POS.</span>
          </div>

          <button type="submit" class="mt-2 w-full h-11 rounded-xl bg-primary hover:bg-primary-dark text-on-primary font-bold text-sm shadow-md transition flex items-center justify-center gap-1.5 active:scale-95">
            <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
            <span>Simpan & Beri Hak Akses</span>
          </button>
        </form>
      </div>
    </div>

  </div>

  <script is:inline>
    const modal = document.getElementById('modalTambahPenjaga');
    document.getElementById('btnOpenTambahPenjaga')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('btnCloseTambahPenjagaModal')?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Search filter
    document.getElementById('searchPenjagaInput')?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll('.penjaga-row').forEach(row => {
        const name = row.dataset.name || '';
        if (name.includes(q)) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    });
  </script>
</Layout>
