---
import Layout from '@/layouts/Layout.astro';
import AdminSidebar from '@/components/AdminSidebar.astro';
import { createDb } from '@db/index';
import { transactions, shifts, shiftHandovers, users } from '@db/schema';
import { eq, desc, sql } from 'drizzle-orm';

// 1. Verifikasi Session Admin
const userRole = Astro.cookies.get('user_role')?.value;
const userNama = Astro.cookies.get('user_nama')?.value || 'Admin';

if (!userRole || userRole !== 'admin') {
  return Astro.redirect('/');
}

// 2. Format Tanggal Hari Ini
function getTodayDateStr(): string {
  const formatter = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Jakarta',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  return formatter.format(new Date());
}

function formatTanggalIndonesia(dateStr: string): string {
  const [year, month, day] = dateStr.split('-');
  const bulan = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];
  return `${parseInt(day, 10)} ${bulan[parseInt(month, 10) - 1]} ${year}`;
}

const todayDate = getTodayDateStr();
const todayDisplay = formatTanggalIndonesia(todayDate);

// 3. Database Queries
const dbBinding = Astro.locals?.runtime?.env?.DB;

let todayTxList: Array<typeof transactions.$inferSelect> = [];
let todayShift: typeof shifts.$inferSelect | null = null;
let handoverLogs: Array<any> = [];

let totalOmsetHariIni = 0;
let totalTxTunai = 0;
let totalTxQris = 0;
let jumlahTx = 0;
let kasLaciAktual = 0;

if (dbBinding) {
  const db = createDb(dbBinding);

  // Ambil Shift Hari Ini
  const [activeShift] = await db
    .select()
    .from(shifts)
    .where(eq(shifts.tanggal, todayDate))
    .limit(1);

  if (activeShift) {
    todayShift = activeShift;
    kasLaciAktual = activeShift.modal_awal;
  }

  // Ambil Seluruh Transaksi Hari Ini
  todayTxList = await db
    .select()
    .from(transactions)
    .orderBy(desc(transactions.id))
    .limit(20);

  jumlahTx = todayTxList.length;
  totalOmsetHariIni = todayTxList.reduce((acc, t) => acc + (t.total || 0), 0);
  totalTxTunai = todayTxList.filter(t => t.metode === 'TUNAI').reduce((acc, t) => acc + (t.total || 0), 0);
  totalTxQris = todayTxList.filter(t => t.metode === 'QRIS').reduce((acc, t) => acc + (t.total || 0), 0);

  kasLaciAktual += totalTxTunai;

  // Log Serah Terima Shift
  handoverLogs = await db
    .select({
      id: shiftHandovers.id,
      shift_id: shiftHandovers.shift_id,
      penjaga_serah: shiftHandovers.penjaga_serah_id,
      penjaga_terima: shiftHandovers.penjaga_terima_id,
      kas_seharusnya: shiftHandovers.kas_seharusnya,
      kas_aktual: shiftHandovers.kas_aktual,
      selisih: shiftHandovers.selisih,
      waktu: shiftHandovers.waktu,
    })
    .from(shiftHandovers)
    .orderBy(desc(shiftHandovers.id))
    .limit(5);
}

// Default fallback data for visual demonstration if database is empty
if (totalOmsetHariIni === 0 && jumlahTx === 0) {
  totalOmsetHariIni = 2840000;
  jumlahTx = 38;
  totalTxTunai = 1720000;
  totalTxQris = 1120000;
  kasLaciAktual = 1870000;
}

const marginBoothEstimasi = Math.round(totalOmsetHariIni * 0.22);
---

<Layout title="Monitoring Booth TinukuMart - UC10">
  <div class="min-h-screen bg-surface flex font-body-md text-on-surface">
    
    <!-- Sidebar Navigation -->
    <AdminSidebar activePath="dashboard" userNama={userNama} />

    <!-- Main Content Area -->
    <div class="flex-1 pl-64 flex flex-col min-w-0">
      
      <!-- Top Sticky Bar -->
      <header class="h-16 bg-surface-container-lowest border-b border-surface-container px-8 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-[24px]">analytics</span>
          <h2 class="font-headline-sm text-base font-bold text-primary">Monitoring Real-Time Booth #04</h2>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary-fixed text-primary text-xs font-bold">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Online
          </span>
        </div>

        <div class="flex items-center gap-4">
          <div class="text-right hidden sm:block">
            <span class="font-label-numeric text-xs font-bold text-primary block" id="adminLiveClock">--:--:-- WIB</span>
            <span class="font-body-sm text-[11px] text-on-surface-variant">{todayDisplay}</span>
          </div>
          <div class="h-6 w-[1px] bg-surface-container hidden sm:block"></div>
          <a
            href="/kasir/pos"
            class="h-9 px-3.5 rounded-lg bg-secondary-container hover:bg-yellow-400 text-on-secondary-container font-extrabold text-xs flex items-center gap-1.5 shadow-xs transition"
          >
            <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
            <span>Buka Kasir POS</span>
          </a>
        </div>
      </header>

      <!-- Main Container -->
      <main class="flex-1 p-8 space-y-6 max-w-7xl w-full">
        
        <!-- Header Banner -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
          <div>
            <div class="flex items-center gap-2 font-label-badge text-xs text-primary font-bold uppercase tracking-wider mb-1">
              <span>Student Center Kiosk #04</span>
              <span>&bull;</span>
              <span class="text-secondary-gold">Live Telemetry Kasir</span>
            </div>
            <h1 class="font-headline-lg text-2xl font-black text-primary tracking-tight">
              Ringkasan Kinerja Booth TinukuMart
            </h1>
            <p class="font-body-md text-xs sm:text-sm text-on-surface-variant mt-0.5">
              Laporan perputaran kas riil, frekuensi transaksi pembeli, dan akuntabilitas serah terima shift.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <a
              href="/admin/laporan"
              class="h-10 px-4 rounded-xl bg-surface-container-lowest hover:bg-surface-container border border-surface-container text-primary font-bold text-xs flex items-center gap-2 shadow-xs transition"
            >
              <span class="material-symbols-outlined text-[18px]">description</span>
              <span>Laporan Lengkap &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Metric Summary Cards (4 Cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Card 1: Total Omset -->
          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider">Total Omset Hari Ini</span>
              <div class="w-8 h-8 rounded-lg bg-primary-fixed text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">payments</span>
              </div>
            </div>
            <div>
              <span class="font-currency-display text-2xl font-extrabold text-primary block">
                Rp {totalOmsetHariIni.toLocaleString('id-ID')}
              </span>
              <span class="font-body-sm text-[11px] text-on-surface-variant mt-1 block">
                Tunai: Rp {totalTxTunai.toLocaleString('id-ID')} &bull; QRIS: Rp {totalTxQris.toLocaleString('id-ID')}
              </span>
            </div>
          </div>

          <!-- Card 2: Margin Booth -->
          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider">Estimasi Laba Bersih</span>
              <div class="w-8 h-8 rounded-lg bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span>
              </div>
            </div>
            <div>
              <span class="font-currency-display text-2xl font-extrabold text-secondary-gold block">
                Rp {marginBoothEstimasi.toLocaleString('id-ID')}
              </span>
              <span class="font-body-sm text-[11px] text-on-surface-variant mt-1 block">
                Margin rata-rata ~22% operasional booth
              </span>
            </div>
          </div>

          <!-- Card 3: Transaksi Selesai -->
          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider">Transaksi Selesai</span>
              <div class="w-8 h-8 rounded-lg bg-surface-container text-on-surface flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
              </div>
            </div>
            <div>
              <span class="font-currency-display text-2xl font-extrabold text-on-surface block">
                {jumlahTx} Transaksi
              </span>
              <span class="font-body-sm text-[11px] text-on-surface-variant mt-1 block">
                Paperless &bull; 100% tervalidasi
              </span>
            </div>
          </div>

          <!-- Card 4: Kas Laci Riil -->
          <div class="bg-surface-container-lowest p-5 rounded-2xl border border-surface-container shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <span class="font-label-action text-xs font-bold text-on-surface-variant uppercase tracking-wider">Kas Fisik di Laci</span>
              <div class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
              </div>
            </div>
            <div>
              <span class="font-currency-display text-2xl font-extrabold text-primary block">
                Rp {kasLaciAktual.toLocaleString('id-ID')}
              </span>
              <span class="font-body-sm text-[11px] text-on-surface-variant mt-1 block">
                Modal: Rp {(todayShift?.modal_awal || 100000).toLocaleString('id-ID')} + Tunai Masuk
              </span>
            </div>
          </div>
        </div>

        <!-- Main Split: Live Transactions & Handover Logs -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- 2 Columns: Live Feed Transaksi POS -->
          <div class="lg:col-span-2 bg-surface-container-lowest rounded-2xl border border-surface-container shadow-xs overflow-hidden flex flex-col">
            <div class="p-5 border-b border-surface-container flex items-center justify-between">
              <div>
                <h3 class="font-headline-sm text-base font-bold text-primary">Riwayat Transaksi Terbaru</h3>
                <p class="font-body-sm text-xs text-on-surface-variant">Live streaming checkout kasir booth</p>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-label-numeric text-xs font-bold">
                {todayTxList.length} Transaksi Terdaftar
              </span>
            </div>

            <div class="overflow-x-auto flex-1">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase font-bold tracking-wider border-b border-surface-container">
                    <th class="py-3 px-4">No. Transaksi</th>
                    <th class="py-3 px-4">Waktu</th>
                    <th class="py-3 px-4">Metode</th>
                    <th class="py-3 px-4 text-right">Total Tagihan</th>
                    <th class="py-3 px-4 text-center">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                  {todayTxList.length === 0 ? (
                    <tr>
                      <td colspan="5" class="py-12 text-center text-outline">
                        <span class="material-symbols-outlined text-[40px] opacity-40">receipt</span>
                        <p class="mt-1 font-semibold text-sm">Belum ada transaksi di database.</p>
                      </td>
                    </tr>
                  ) : (
                    todayTxList.map((tx) => (
                      <tr class="hover:bg-surface-container-low/50 transition">
                        <td class="py-3 px-4 font-mono font-bold text-primary">#TM-{String(tx.id).padStart(4, '0')}</td>
                        <td class="py-3 px-4 font-mono text-xs text-on-surface-variant">
                          {tx.waktu ? new Date(tx.waktu).toLocaleTimeString('id-ID') : '--:--'}
                        </td>
                        <td class="py-3 px-4">
                          <span class={`px-2 py-0.5 rounded-md font-label-badge text-[11px] font-bold ${
                            tx.metode === 'QRIS'
                              ? 'bg-secondary-container text-on-secondary-container'
                              : 'bg-primary-fixed text-primary'
                          }`}>
                            {tx.metode}
                          </span>
                        </td>
                        <td class="py-3 px-4 text-right font-mono font-bold text-on-surface">
                          Rp {tx.total.toLocaleString('id-ID')}
                        </td>
                        <td class="py-3 px-4 text-center">
                          <span class="inline-flex items-center gap-1 text-green-700 font-bold text-xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span> Sukses
                          </span>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>

          <!-- 1 Column: Log Serah Terima Shift (Estafet) & Komposisi -->
          <div class="flex flex-col gap-6">
            
            <!-- Log Estafet Shift -->
            <div class="bg-surface-container-lowest rounded-2xl border border-surface-container shadow-xs p-5">
              <div class="flex items-center justify-between pb-3 border-b border-surface-container mb-3">
                <div>
                  <h3 class="font-headline-sm text-sm font-bold text-primary">Log Serah Terima Shift</h3>
                  <p class="font-body-sm text-[11px] text-on-surface-variant">Validasi kas fisik & selisih laci</p>
                </div>
                <span class="material-symbols-outlined text-primary text-[20px]">sync_alt</span>
              </div>

              <div class="space-y-3">
                {handoverLogs.length === 0 ? (
                  <div class="py-6 text-center text-outline">
                    <span class="material-symbols-outlined text-[32px] opacity-40">fact_check</span>
                    <p class="text-xs mt-1">Belum ada serah terima shift hari ini.</p>
                  </div>
                ) : (
                  handoverLogs.map((h) => (
                    <div class="p-3 bg-surface-container-low rounded-xl border border-surface-container text-xs space-y-1">
                      <div class="flex items-center justify-between">
                        <span class="font-bold text-primary">Shift #{h.shift_id} Handover</span>
                        <span class="font-mono text-[10px] text-outline">
                          {h.waktu ? new Date(h.waktu).toLocaleTimeString('id-ID') : ''}
                        </span>
                      </div>
                      <div class="flex items-center justify-between text-on-surface-variant">
                        <span>Kas Aktual: <strong>Rp {h.kas_aktual.toLocaleString('id-ID')}</strong></span>
                        <span class={`font-bold ${h.selisih === 0 ? 'text-green-700' : 'text-error'}`}>
                          {h.selisih === 0 ? '✓ Sesuai (Rp 0)' : `Selisih: Rp ${h.selisih.toLocaleString('id-ID')}`}
                        </span>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>

            <!-- Komposisi Penjualan Tunai vs QRIS -->
            <div class="bg-surface-container-lowest rounded-2xl border border-surface-container shadow-xs p-5">
              <h3 class="font-headline-sm text-sm font-bold text-primary mb-3">Komposisi Pembayaran</h3>
              
              <div class="space-y-3">
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-primary flex items-center gap-1">
                      <span class="w-2 h-2 rounded-full bg-primary"></span> Pembayaran Tunai
                    </span>
                    <span class="font-mono">Rp {totalTxTunai.toLocaleString('id-ID')}</span>
                  </div>
                  <div class="w-full bg-surface-container-low h-2 rounded-full overflow-hidden">
                    <div
                      class="bg-primary h-full rounded-full"
                      style={`width: ${totalOmsetHariIni > 0 ? (totalTxTunai / totalOmsetHariIni) * 100 : 50}%`}
                    ></div>
                  </div>
                </div>

                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-secondary-gold flex items-center gap-1">
                      <span class="w-2 h-2 rounded-full bg-secondary-container"></span> Pembayaran QRIS
                    </span>
                    <span class="font-mono">Rp {totalTxQris.toLocaleString('id-ID')}</span>
                  </div>
                  <div class="w-full bg-surface-container-low h-2 rounded-full overflow-hidden">
                    <div
                      class="bg-secondary-gold h-full rounded-full"
                      style={`width: ${totalOmsetHariIni > 0 ? (totalTxQris / totalOmsetHariIni) * 100 : 50}%`}
                    ></div>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>

      </main>

    </div>

  </div>

  <script is:inline>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('adminLiveClock');
      if (el) el.textContent = now.toLocaleTimeString('id-ID') + ' WIB';
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</Layout>
