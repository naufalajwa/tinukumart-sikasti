---
interface Props {
  activePath: 'dashboard' | 'produk' | 'penjaga' | 'laporan';
  userNama?: string;
}

const { activePath, userNama = 'Admin' } = Astro.props;

const navItems = [
  { id: 'dashboard', label: 'Ringkasan Monitoring', href: '/admin/dashboard', icon: 'dashboard' },
  { id: 'produk', label: 'Manajemen Produk', href: '/admin/produk', icon: 'inventory_2' },
  { id: 'penjaga', label: 'Data Penjaga Shift', href: '/admin/penjaga', icon: 'group' },
  { id: 'laporan', label: 'Laporan Keuangan', href: '/admin/laporan', icon: 'bar_chart' },
];
---

<!-- Mobile Backdrop Overlay -->
<div
  id="adminSidebarBackdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 lg:hidden hidden transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Responsive Sidebar Drawer -->
<aside
  id="adminSidebar"
  class="fixed left-0 top-0 h-full w-72 lg:w-64 bg-primary text-on-primary z-50 flex flex-col justify-between shadow-2xl lg:shadow-lg transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <div class="flex flex-col">
    <!-- Brand Header & Close Button on Mobile -->
    <div class="h-16 px-5 flex items-center justify-between border-b border-white/10">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-surface-container-lowest text-primary flex items-center justify-center font-bold shadow-xs overflow-hidden shrink-0">
          <img
            src="/logo-tinuku.png"
            alt="Logo Tinuku"
            class="w-full h-full object-contain p-0.5"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
          />
          <span class="material-symbols-outlined text-[24px] hidden">storefront</span>
        </div>
        <div class="flex flex-col">
          <span class="font-headline-sm text-base font-bold text-white leading-tight">TinukuMart</span>
          <span class="font-label-badge text-[10px] text-primary-fixed tracking-wider uppercase font-bold">
            Panel Administrator
          </span>
        </div>
      </div>

      <!-- Close button on Mobile (< lg) -->
      <button
        type="button"
        id="adminSidebarCloseBtn"
        class="lg:hidden w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition active:scale-95"
        title="Tutup Menu"
      >
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex flex-col gap-1.5 p-4 overflow-y-auto max-h-[calc(100vh-170px)]">
      <span class="text-[11px] font-bold text-primary-fixed-dim uppercase tracking-wider px-3 mb-1">
        Menu Utama
      </span>
      {navItems.map((item) => {
        const isActive = activePath === item.id;
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-label-action text-sm font-semibold transition-all ${
              isActive
                ? 'bg-secondary-container text-on-secondary-container font-bold shadow-sm'
                : 'text-primary-fixed hover:bg-white/10 hover:text-white'
            }`}
          >
            <span class="material-symbols-outlined text-[20px]">{item.icon}</span>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Bottom Admin Profile & Logout -->
  <div class="p-4 border-t border-white/10 flex flex-col gap-3 bg-primary-dark">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold text-xs shadow-xs shrink-0">
        {userNama.substring(0, 2).toUpperCase()}
      </div>
      <div class="flex flex-col min-w-0">
        <span class="font-bold text-sm text-white truncate">{userNama}</span>
        <span class="text-[11px] text-primary-fixed-dim truncate">Administrator Booth #04</span>
      </div>
    </div>
    <a
      href="/api/auth?action=logout"
      class="w-full py-2 px-3 rounded-lg bg-white/10 hover:bg-error hover:text-white text-primary-fixed text-xs font-bold transition flex items-center justify-center gap-2 active:scale-95"
    >
      <span class="material-symbols-outlined text-[16px]">logout</span>
      <span>Keluar (Logout)</span>
    </a>
  </div>
</aside>

<!-- Client Script for Responsive Mobile Drawer -->
<script is:inline>
  (() => {
    const sidebar = document.getElementById('adminSidebar');
    const backdrop = document.getElementById('adminSidebarBackdrop');
    const closeBtn = document.getElementById('adminSidebarCloseBtn');

    function openSidebar() {
      if (sidebar && backdrop) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
      }
    }

    function closeSidebar() {
      if (sidebar && backdrop) {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }
    }

    // Attach listener to any open buttons
    document.querySelectorAll('.btn-open-sidebar').forEach((btn) => {
      btn.addEventListener('click', openSidebar);
    });

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });
  })();
</script>
